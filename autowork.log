+    client = _build_test_client(monkeypatch)
+
+    response = client.post(
+        "/login",
+        data={"password": "wrong", "next": "/accounts"},
+    )
+
+    assert response.status_code == 401
+    assert "Incorrect password" in response.text
+
+
