import re, subprocess
result = subprocess.run(['git', 'ls-files'], capture_output=True, text=True)
files = [f for f in result.stdout.strip().split('\n') if f.endswith(('.py', '.js', '.html'))]
patterns = [
    (r'\bwhether\b', 'whether → if/True if'),
    (r'\bobtain\b', 'obtain → get/retrieve'),
    (r'\bencapsulation\b', 'encapsulation → wrapper'),
    (r'\bmodal box\b', 'modal box → modal'),
    (r'\bfill in\b', 'fill in → enter'),
    (r'\bself-deployed\b', 'self-deployed → self-hosted'),
    (r'\bmailing list\b', 'mailing list → email list'),
    (r'\bhas been\b', 'has been → active form'),
    (r'\bdoes not exist\b', 'does not exist → not found'),
    (r'\bconfiguration items?\b', 'configuration item → setting'),
    (r'\bverification code\b', 'verification code → OTP'),
    (r'\binterface\b', 'interface → API/endpoint (context-dependent)'),
]
for pat, label in patterns:
    count = 0
    for fname in files:
        try:
            with open(fname, 'r') as f:
                text = f.read()
                matches = re.findall(pat, text, re.IGNORECASE)
                count += len(matches)
        except: pass
    if count > 0:
        print(f'{label}: {count} occurrences')
"
