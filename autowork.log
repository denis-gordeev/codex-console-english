import re, subprocess
result = subprocess.run(['git', 'ls-files'], capture_output=True, text=True)
files = [f for f in result.stdout.strip().split('\n') if f.endswith(('.py', '.js', '.html'))]
patterns = [
    (r'\bcurrent limit(ing|ed)?\b', 'current limiting → rate limiting'),
    (r'\bprivate domain\b', 'private domain → custom domain'),
    (r'\binterface\b', 'interface → API/endpoint'),
    (r'\baccording to\b', 'according to → by'),
    (r'\bExecute\b', 'Execute → Run'),
    (r'\bfront end\b', 'front end → frontend'),
    (r'\bmodal box\b', 'modal box → modal'),
    (r'\bself-deployed\b', 'self-deployed → self-hosted'),
    (r'\bmailing list\b', 'mailing list → email list'),
    (r'\bencapsulation\b', 'encapsulation → wrapper'),
    (r'\bfill in\b', 'fill in → enter'),
    (r'\bdoes not exist\b', 'does not exist → not found'),
    (r'\bconfiguration items?\b', 'configuration item → setting'),
    (r'\btemporary mailbox\b', 'temporary mailbox → temp mail'),
    (r'\bcustomized\b', 'customized → custom'),
    (r'\bsynchronization tasks?\b', 'synchronization task → synchronous task'),
]
for pat, label in patterns:
    hits = []
    for fname in files:
        try:
            with open(fname, 'r') as f:
                for i, line in enumerate(f, 1):
                    if re.search(pat, line, re.IGNORECASE):
                        hits.append(f'{fname}:{i}')
        except: pass
    if hits:
        print(f'{label}: {hits}')
